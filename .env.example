# Copy to .env for local work. On Vercel, add these under Project Settings > Environment Variables.
# Never commit a real .env file.

# --- Supabase (your own project: Project Settings > API) ---
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server only. Keep secret. Used to save contact-form messages.
SUPABASE_SERVICE_ROLE_KEY=

# --- Label scanner (Claude) ---
# Server only. Create at console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Maximum AI scans per user per rolling 24 hours
SCAN_DAILY_LIMIT=20

# --- Email (contact-form notifications) via the SMTP mailbox for hello@paarlwine.com ---
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=hello@paarlwine.com
SMTP_PASS=
SMTP_FROM=Paarl Wine <hello@paarlwine.com>

# --- Google sign-in (optional) ---
# Set to true only after enabling the Google provider in Supabase. Leave unset to hide the button.
VITE_GOOGLE_SIGNIN=
